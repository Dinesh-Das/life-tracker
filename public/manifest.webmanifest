{
    "name": "LifeTracker — Personal Habit Dashboard",
    "short_name": "LifeTracker",
    "description": "Track daily habits, plan weekly goals, and visualize personal growth — your data stays in your own Google Sheet.",
    "start_url": "/",
    "scope": "/",
    "display": "standalone",
    "orientation": "portrait",
    "background_color": "#0a160f",
    "theme_color": "#0a160f",
    "icons": [
        {
            "src": "/logo.png",
            "sizes": "192x192",
            "type": "image/png",
            "purpose": "any"
        },
        {
            "src": "/logo.png",
            "sizes": "512x512",
            "type": "image/png",
            "purpose": "any maskable"
        }
    ],
    "shortcuts": [
        {
            "name": "Daily Check-in",
            "short_name": "Check-in",
            "description": "Log today's habits and mental state",
            "url": "/daily",
            "icons": [{ "src": "/logo.png", "sizes": "192x192" }]
        },
        {
            "name": "Planner",
            "short_name": "Planner",
            "description": "View this week's tasks",
            "url": "/planner",
            "icons": [{ "src": "/logo.png", "sizes": "192x192" }]
        },
        {
            "name": "Focus Timer",
            "short_name": "Focus",
            "description": "Start a deep work session",
            "url": "/focus",
            "icons": [{ "src": "/logo.png", "sizes": "192x192" }]
        }
    ]
}